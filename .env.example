# Ajustes de despliegue de Dis. Copia este fichero a `.env` (junto a
# docker-compose.yml) y cambia lo que necesites; todo es opcional.

# Puerto del host en el que se publica Dis.
DIS_PORT=8088

# Host fijo para los enlaces `{host}` (p. ej. el nombre de Tailscale del
# servidor). Vacío = el host con el que abres Dis, que suele ser lo que quieres.
DIS_PUBLIC_HOST=

# Discos del host a mostrar en "Recursos", separados por comas. Vacío = los de
# dis.yaml (por defecto, solo /).
DIS_DISKS=

# URL base de la API de Cerbero. Vacío = "Cerbero no conectado".
CERBERO_URL=
